# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# MongoDB Atlas connection string (server-side only, never NEXT_PUBLIC_).
# Get it from Atlas → Connect → Drivers. Include the database name in the path.
MONGODB_URI=
MONGODB_DB=lca_timetable

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical origin. http://localhost:3000 locally; the real domain in production.
AUTH_URL=http://localhost:3000

# Optional. How long one realtime (SSE) connection is held before it recycles
# itself, in seconds. Must stay BELOW your hosting plan's function duration
# limit. Default 240. See docs/deployment.md.
STREAM_LIFETIME_SECONDS=
